# vim: ft=python

panic = module("panic.serial",
    target = "kernel",
    deps = [ "util", "elf", "kernel" ],
    static = True,
    includes = [ ".." ],
    description = "Serial panic handler",
    ld_script = "panic.serial.ld",
    skip_arches = [ "linux" ],
    sources = [
        "display.cpp",
        "entry.s",
        "main.cpp",
        "serial.cpp",
        "symbol_table.cpp",
    ])
