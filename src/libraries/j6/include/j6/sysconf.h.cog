from jsix.sysconf import load_sysconf
address, vars = load_sysconf(Path(definitions_path) / "sysconf.toml")
]]]*/
///[[[end]]]

#ifdef __cplusplus
extern "C" {
#endif

enum j6_sysconf_arg
{
    /*[[[cog code generation
    for var in vars:
        cog.outl(f"j6sc_{var.name},")
    ]]]*/
    ///[[[end]]]

    j6sc_MAX
};

/// Get the kernel configuration value specified by
/// the argument.
unsigned long API j6_sysconf(j6_sysconf_arg arg);

#ifdef __cplusplus
} // extern C
#endif

#endif // __j6kernel
